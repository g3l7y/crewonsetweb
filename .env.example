# ============================================================
# Crew On Set — Environment Variables
# ============================================================

# --- Client-safe (exposed to browser via Vite) ---

# PlayFab Title ID (public, safe for client-side)
VITE_PLAYFAB_TITLE_ID=D4EA4

# PlayFab mode: "mock" for development, "real" for production
# Mock mode uses realistic demo data and does not call PlayFab.
# Real mode calls the actual PlayFab REST API.
VITE_PLAYFAB_MODE=real

# Google OAuth Web client ID (public; required for real Google player login)
VITE_GOOGLE_CLIENT_ID=replace_with_google_web_client_id

# --- Server-only (NEVER exposed to the browser) ---

# PlayFab Developer Secret Key
# Required for server-side admin operations (player tags, currency grants, etc.)
# Get this from your PlayFab Game Manager > Settings > Secret Keys
# WARNING: This must NEVER appear in client code, Vite defines, or git.
PLAYFAB_SECRET_KEY=replace_with_server_only_secret

# PlayFab Content > Email Templates: Account Recovery template ID.
# Its callback URL must be https://your-domain.example/password-recovery.
PLAYFAB_RECOVERY_EMAIL_TEMPLATE_ID=replace_with_account_recovery_template_id

# PayMongo Hosted Checkout (server-only; use sk_test_... during development)
# In VITE_PLAYFAB_MODE=mock, a test key makes the demo checkout open PayMongo's
# hosted test page; without it, demo accounts use the local fallback.
PAYMONGO_SECRET_KEY=replace_with_paymongo_secret_key
PAYMONGO_WEBHOOK_SECRET=replace_with_paymongo_webhook_secret
# Display name on the PayMongo Hosted Checkout page in both Test and Live modes.
PAYMONGO_MERCHANT_NAME=CREW ON SET
# PayMongo only shows methods activated on the matching account/mode.
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph

# Neon Postgres connection string for the PayMongo idempotency ledger (server-only).
# Connect Neon through the Vercel Marketplace; it will add DATABASE_URL automatically.
DATABASE_URL=replace_with_neon_database_url

# Public HTTPS origin used for PayMongo return URLs
PUBLIC_APP_URL=https://your-domain.example
